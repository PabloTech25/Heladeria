---
import Header from "../components/Header.astro";
import MenuCategoriesExpanded from "../components/MenuCategoriesExpanded.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.svelte";
import CartToast from "../components/CartToast.svelte";
import AddToCartButton from "../components/AddToCartButton.svelte";
import { products } from "../data/products";
import { getCloudinaryUrl } from "../lib/cloudinary";
import "../styles/global.css";

const featuredItems = products.filter((p) => p.featured).slice(0, 4);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="Cafetería y heladería artesanal en Ciudad Serdán, Puebla. Café de especialidad, frappes, crepas y helados. Consulta el menú y pide en línea."
		/>
		<meta
			name="keywords"
			content="cafetería Puebla, café artesanal, café gourmet, cafetería artesanal, frappes artesanales, bebidas especiales, café Puebla, cafetería en Ciudad Serdán, coffee shop Puebla, café premium, helados artesanales, postres frescos, crepas dulces, desayunos sorpresa, donde tomar café Puebla, Chaud & Glace"
		/>
		<meta name="geo.region" content="MX-PUE" />
		<meta name="geo.placename" content="Ciudad Serdán" />
		<meta name="geo.position" content="18.9833;-97.4500" />
		<meta name="ICBM" content="18.9833, -97.4500" />
		<title>Chaud &amp; Glace | Café y Helados Artesanales en Ciudad Serdán</title>

		<!-- Canonical URL -->
		<link rel="canonical" href="https://chaudglace.com/" />

		<!-- Open Graph Meta Tags -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://chaudglace.com/" />
		<meta
			property="og:title"
			content="Chaud & Glace | Cafetería Gourmet y Heladería Artesanal"
		/>
		<meta
			property="og:description"
			content="Café gourmet, frappes premium, crepas artesanales y helados de receta tradicional en el corazón de Ciudad Serdán. Pide en línea a través de WhatsApp."
		/>
		<meta
			property="og:image"
			content="https://chaudglace.com/logo/LogoChaud.png"
		/>
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Chaud & Glace - Helados Artesanales y Cafetería en Puebla"
		/>
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="Chaud & Glace" />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content="https://chaudglace.com/" />
		<meta
			name="twitter:title"
			content="Chaud & Glace | Cafetería Gourmet y Helados Artesanales"
		/>
		<meta
			name="twitter:description"
			content="Cafetería artesanal en Ciudad Serdán, Puebla. Café gourmet, frappes, crepas dulces y helados artesanales."
		/>
		<meta
			name="twitter:image"
			content="https://chaudglace.com/logo/LogoChaud.png"
		/>

		<!-- Favicons -->
		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href="/logo/LogoIcon.png"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href="/logo/LogoIcon.png"
		/>
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/logo/LogoIcon.png"
		/>
		<link rel="shortcut icon" href="/logo/LogoIcon.png" />

		<!-- Google Fonts: Bodoni Moda (Editorial Display) + Plus Jakarta Sans (Clean Modern UI) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..800;1,6..96,400..800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<!-- JSON-LD Structured Data: LocalBusiness -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": [
					"Cafe",
					"LocalBusiness",
					"CoffeeShop",
					"Restaurant",
					"IceCreamShop"
				],
				"@id": "https://chaudglace.com/#business",
				"name": "Chaud & Glace - Cafetería Gourmet y Helado Artesanal",
				"image": [
					"https://chaudglace.com/logo/LogoChaud.png",
					"https://chaudglace.com/hero-background.png",
					"https://chaudglace.com/about-image.jpeg"
				],
				"description": "Chaud & Glace: Cafetería artesanal en Puebla especializada en café gourmet premium, frappes artesanales, bebidas especiales, crepas dulces, desayunos sorpresa, helados artesanales gourmet y repostería fresca. Ubicados en Ciudad Serdán con ingredientes premium y técnicas de barismo profesional.",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "Calle 3 Poniente #8, Col. Centro",
					"addressLocality": "Ciudad Serdán",
					"addressRegion": "Puebla",
					"postalCode": "75220",
					"addressCountry": "MX"
				},
				"geo": {
					"@type": "GeoCoordinates",
					"latitude": 18.9833,
					"longitude": -97.45,
					"name": "Chaud & Glace - Ciudad Serdán, Puebla"
				},
				"url": "https://chaudglace.com",
				"telephone": "+52-245-452-2978",
				"priceRange": "$$",
				"servesCuisine": [
					"Cafetería",
					"Café Gourmet",
					"Bebidas Especiales",
					"Frappes Artesanales",
					"Crepas",
					"Postres",
					"Helados Artesanales",
					"Desayunos",
					"Repostería"
				],
				"logo": "https://chaudglace.com/logo/LogoChaud.png",
				"openingHoursSpecification": [
					{
						"@type": "OpeningHoursSpecification",
						"dayOfWeek": [
							"Monday",
							"Tuesday",
							"Wednesday",
							"Thursday",
							"Friday",
							"Saturday",
							"Sunday"
						],
						"opens": "11:00",
						"closes": "21:00"
					}
				],
				"areaServed": [
					{
						"@type": "City",
						"name": "Ciudad Serdán"
					},
					{
						"@type": "State",
						"name": "Puebla"
					},
					{
						"@type": "Country",
						"name": "México"
					}
				],
				"sameAs": [
					"https://www.facebook.com/share/1ApReivZHt/?mibextid=wwXIfr",
					"https://www.instagram.com/chaud.and.glace"
				],
				"aggregateRating": {
					"@type": "AggregateRating",
					"ratingValue": "4.8",
					"reviewCount": "127",
					"bestRating": "5",
					"worstRating": "1"
				},
				"hasMap": "https://maps.google.com/?q=Chaud+Glace+Ciudad+Serdan+Puebla"
			}
		</script>

		<!-- JSON-LD Structured Data: BreadcrumbList -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "BreadcrumbList",
				"itemListElement": [
					{
						"@type": "ListItem",
						"position": 1,
						"name": "Inicio",
						"item": "https://chaudglace.com"
					},
					{
						"@type": "ListItem",
						"position": 2,
						"name": "Menú de Helados y Café",
						"item": "https://chaudglace.com/#menu"
					},
					{
						"@type": "ListItem",
						"position": 3,
						"name": "Contacto y Ubicación",
						"item": "https://chaudglace.com/#contacto"
					}
				]
			}
		</script>
	</head>

	<body
		class="font-['Plus_Jakarta_Sans',sans-serif] antialiased text-espresso-950 bg-[#fdfbf7]"
	>
		<!-- Header -->
		<Header currentPage="home" />

		<!-- ═══════════════════════════════════════════════════════════════ -->
		<!-- HERO SECTION -->
		<!-- ═══════════════════════════════════════════════════════════════ -->
		<section
			id="inicio"
			class="relative isolate overflow-hidden bg-espresso-950 pt-24 sm:pt-28 pb-14 sm:pb-24 text-white"
		>
			<!-- Background Layer with Image + Radial Luxury Vignettes -->
			<div class="absolute inset-0 -z-10 overflow-hidden">
				<picture>
					<source srcset="/hero-background.webp" type="image/webp" />
					<img
						src="/hero-background.png"
						alt=""
						aria-hidden="true"
						class="h-full w-full object-cover object-center opacity-30 mix-blend-luminosity scale-105"
						loading="lazy"
						decoding="async"
						fetchpriority="low"
					/>
				</picture>
				<!-- Radial Ambient Gradients (Warm roast espresso + berry glow + golden caramel) -->
				<div
					class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_30%,rgba(219,39,102,0.3)_0%,transparent_60%)]"
				>
				</div>
				<div
					class="absolute inset-0 bg-[radial-gradient(ellipse_at_80%_70%,rgba(212,154,38,0.2)_0%,transparent_60%)]"
				>
				</div>
				<div
					class="absolute inset-0 bg-gradient-to-b from-espresso-950/80 via-espresso-950/92 to-[#fdfbf7]"
				>
				</div>
			</div>

			<!-- Floating Subtle Geometry (Clamped to prevent horizontal overflow on mobile) -->
			<div
				class="pointer-events-none absolute -left-16 sm:-left-24 top-1/4 h-64 sm:h-80 w-64 sm:w-80 rounded-full border border-white/5 opacity-40 blur-2xl"
			>
			</div>
			<div
				class="pointer-events-none absolute -right-16 sm:-right-20 top-1/3 h-72 sm:h-96 w-72 sm:w-96 rounded-full border border-chaud-500/10 opacity-50 blur-3xl"
			>
			</div>

			<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div
					class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16 pt-4 sm:pt-8"
				>
					<!-- Hero Copy & Value Proposition -->
					<div class="lg:col-span-12 max-w-3xl text-left">
						<!-- Main Headline -->
						<h1
							class="store-display text-3xl sm:text-5xl lg:text-[4.75rem] font-bold leading-[1.08] sm:leading-[1.02] tracking-tight text-white"
						>
							Tu pausa favorita, servida al momento.
						</h1>

						<!-- Subtitle -->
						<p
							class="mt-4 sm:mt-6 text-sm sm:text-lg leading-relaxed text-warm-100 font-normal"
						>
							La mejor selección de café gourmet, postres recién horneados y helados artesanales. Vive
							la experiencia en nuestro local en Ciudad Serdán, ordena
							para llevar o solicita tu pedido por WhatsApp.
						</p>

						<!-- CTAs Row -->
						<div
							class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center"
						>
							<a
								href="#menu"
								class="shimmer-btn inline-flex min-h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-full bg-chaud-600 px-8 font-bold text-white shadow-xl shadow-chaud-900/40 transition-all hover:-translate-y-0.5 hover:shadow-2xl active:scale-95"
							>
								<span>Explorar la Carta</span>
								<span aria-hidden="true" class="text-sm">↘</span>
							</a>
						</div>

					</div>
				</div>
			</div>
		</section>

		<!-- ═══════════════════════════════════════════════════════════════ -->
		<!-- SECTION: Especialidades de Autor (Curated Bento Showcase) -->
		<!-- ═══════════════════════════════════════════════════════════════ -->
		<section
			id="especialidades"
			class="store-section border-t border-warm-200/80 bg-white py-14 sm:py-24"
			aria-label="Especialidades Destacadas"
		>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div
					class="mb-10 sm:mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-5 border-b border-warm-200/80 pb-6 sm:pb-8"
				>
					<div>
						<div class="store-kicker mb-2.5 flex items-center gap-2">
							<span class="h-2 w-2 rounded-full bg-chaud-500"
							></span>
							<span>Selección del Barista & Maestro Heladero</span
							>
						</div>
						<h2
							class="store-display text-3xl sm:text-5xl font-bold text-espresso-950"
						>
							Nuestras Especialidades
						</h2>
						<p
							class="mt-2.5 text-sm sm:text-base text-warm-700 max-w-xl"
						>
							Las combinaciones más queridas por nuestra
							comunidad. Texturas sedosas, contraste de
							temperaturas y sabores inconfundibles.
						</p>
					</div>

					<a
						href="#menu"
						class="inline-flex w-fit items-center gap-2 rounded-full border border-chaud-200 bg-chaud-50/70 px-4 py-2.5 text-xs sm:text-sm font-bold text-chaud-700 hover:bg-chaud-100 transition active:scale-95"
					>
						<span>Ver toda la carta artesanal</span>
						<span aria-hidden="true">→</span>
					</a>
				</div>

				<!-- Bento Grid -->
				<div
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6"
				>
					{
						featuredItems.map((item) => (
							<div class="card-3d group relative flex flex-col justify-between rounded-3xl border border-warm-200/80 bg-[#fdfbf7] p-4 sm:p-5 shadow-sm transition-all duration-300 hover:border-chaud-300 hover:shadow-xl hover:shadow-chaud-950/5">
								<div>
									<div class="relative aspect-square w-full overflow-hidden rounded-2xl bg-white p-4 flex items-center justify-center border border-warm-200/60">
										<img
											src={getCloudinaryUrl(item.image, {
												width: 360,
											})}
											alt={item.name}
											class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-110"
											loading="lazy"
										/>
										<span class="absolute top-3 left-3 rounded-full bg-espresso-950 px-3 py-1 text-xs font-bold text-white shadow-sm">
											{item.price}
										</span>
									</div>

									<div class="mt-4">
										<span class="text-[0.68rem] font-bold uppercase tracking-wider text-chaud-600">
											{item.category}
										</span>
										<h3 class="font-bold text-base text-espresso-950 group-hover:text-chaud-700 transition-colors leading-snug mt-0.5">
											{item.name}
										</h3>
										<p class="text-xs text-warm-700 line-clamp-2 mt-1 leading-relaxed">
											{item.description}
										</p>
									</div>
								</div>

								<div class="mt-4 pt-3 border-t border-warm-200/70">
									<AddToCartButton
										client:idle
										id={item.id}
										name={item.name}
										price={item.numericPrice}
										image={item.image}
										size={item.size}
									/>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- ═══════════════════════════════════════════════════════════════ -->
		<!-- SECTION: Menú Completo & E-Commerce Catalog -->
		<!-- ═══════════════════════════════════════════════════════════════ -->
		<MenuCategoriesExpanded products={products} />

		<!-- ═══════════════════════════════════════════════════════════════ -->
		<!-- SECTION: Sobre Nosotros / Lo que nos mueve -->
		<!-- ═══════════════════════════════════════════════════════════════ -->
		<section
			id="sobre-nosotros"
			class="store-section border-t border-warm-200/80 bg-[#fbf5eb] py-14 sm:py-24"
			aria-label="Sobre Chaud & Glace"
		>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div
					class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center"
				>
					<!-- Left: Story & Craftsmanship (7 cols) -->
					<div class="lg:col-span-7 space-y-5 sm:space-y-6">
						<div class="store-kicker flex items-center gap-2">
							<span class="h-2 w-2 rounded-full bg-chaud-500"
							></span>
							<span>Nuestra Filosofía Artesanal</span>
						</div>

						<h2
							class="store-display text-3xl sm:text-5xl lg:text-6xl font-bold text-espresso-950 leading-[1.02]"
						>
							El sabor y la calidez existen en el mismo lugar.
						</h2>

						<p
							class="text-sm sm:text-base lg:text-lg text-warm-800 leading-relaxed"
						>
							<strong class="text-chaud-700"
								>Chaud &amp; Glace</strong
							> nace de la hermosa contradicción entre lo cálido y lo
							frío: la reconfortante taza de café recién extraído que
							acompaña a una bola de helado artesanal perfectamente
							fría.
						</p>

						<p
							class="text-xs sm:text-sm lg:text-base text-warm-700 leading-relaxed"
						>
							Nos especializamos en experiencias sensoriales
							únicas. Seleccionamos granos con perfiles de tostado
							precisos y preparamos nuestros helados a diario en
							Ciudad Serdán, utilizando fruta natural y lácteos de
							primera calidad sin atajos industriales.
						</p>

						<div
							class="grid grid-cols-3 gap-2 sm:gap-4 border-t border-warm-300/80 pt-5 sm:pt-6"
						>
							<div class="text-center sm:text-left">
								<span
									class="store-display block text-2xl sm:text-3xl font-bold text-chaud-700"
									>100%</span
								>
								<span
									class="text-[0.72rem] sm:text-xs font-bold text-espresso-950"
									>Artesanal & Natural</span
								>
							</div>
							<div class="text-center sm:text-left">
								<span
									class="store-display block text-2xl sm:text-3xl font-bold text-chaud-700"
									>Fresh</span
								>
								<span
									class="text-[0.72rem] sm:text-xs font-bold text-espresso-950"
									>Hecho al Momento</span
								>
							</div>
							<div class="text-center sm:text-left">
								<span
									class="store-display block text-2xl sm:text-3xl font-bold text-chaud-700"
									>70+</span
								>
								<span
									class="text-[0.72rem] sm:text-xs font-bold text-espresso-950"
									>Opciones en Carta</span
								>
							</div>
						</div>
					</div>

					<!-- Right: Layered Photography with 3D Depth Badge (5 cols) -->
					<div class="lg:col-span-5 relative mt-4 lg:mt-0">
						<div
							class="card-3d relative aspect-square overflow-hidden rounded-3xl border-4 sm:border-8 border-white bg-white shadow-2xl shadow-espresso-950/15"
						>
							<picture>
								<source srcset="/about-image.webp" type="image/webp" />
								<img
									src="/about-image.jpeg"
									alt="Interior y momentos en Chaud & Glace Ciudad Serdán"
									class="h-full w-full object-cover"
									loading="lazy"
									decoding="async"
								/>
							</picture>
						</div>

						<!-- Floating Experience Badge (Clamped to avoid overflow on mobile) -->
						<div
							class="absolute bottom-3 right-3 sm:-bottom-7 sm:-right-7 rounded-2xl bg-espresso-950 p-3.5 sm:p-5 text-white shadow-2xl border border-white/10"
						>
							<strong
								class="store-display block text-2xl sm:text-4xl font-bold text-honey-400"
								>2+</strong
							>
							<span
								class="block text-[0.7rem] sm:text-xs font-semibold tracking-wide text-warm-200"
								>Años endulzando Ciudad Serdán</span
							>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact Form & Location -->
		<ContactForm />

		<!-- Footer -->
		<Footer />

		<!-- Cart System (Svelte Client Islands) -->
		<CartDrawer client:idle />
		<CartToast client:idle />

	</body>
</html>
