---
// Contact Information & Store Location Component
---

<section id="contacto" class="store-section border-t border-warm-200/80 bg-white py-20 sm:py-28" aria-label="Contacto y Ubicación">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="mb-12 text-left sm:mb-16">
            <div class="store-kicker mb-3.5 flex items-center gap-2">
                <span class="inline-block h-2 w-2 rounded-full bg-chaud-500"></span>
                <span>Encuéntranos en Ciudad Serdán</span>
            </div>
            <h2 class="store-display max-w-2xl text-4xl sm:text-5xl lg:text-6xl font-bold text-espresso-950 leading-[0.98]">
                Te Esperamos con una Mesa Lista
            </h2>
            <p class="mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-warm-600">
                Ubicados en el corazón de Ciudad Serdán, justo frente a las emblemáticas letras de Chalchicomula. Visítanos o haz tu pedido para llevar.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
            
            <!-- Contact Cards (5 cols) -->
            <div class="lg:col-span-5 space-y-5">
                
                <!-- Main Info Card -->
                <div class="rounded-3xl bg-espresso-950 p-7 sm:p-9 text-white shadow-xl shadow-espresso-950/20 relative overflow-hidden">
                    <!-- Subtle ambient orb -->
                    <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-chaud-600/25 blur-3xl" aria-hidden="true"></div>

                    <!-- Live Status Badge -->
                    <div id="live-hours-badge" class="mb-6 inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-xs font-semibold backdrop-blur-md border border-white/15">
                        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span id="live-hours-text">Abierto hoy de 11:00 AM a 9:00 PM</span>
                    </div>

                    <h3 class="store-display text-2xl font-bold mb-6 text-white">
                        Atención Personalizada
                    </h3>

                    <div class="space-y-6">
                        <!-- Phone -->
                        <div class="flex items-start gap-4">
                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-white/10 text-white backdrop-blur-sm border border-white/10">
                                <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a11 11 0 011.21-.502l4.493 1.498a2 2 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="text-xs uppercase tracking-wider font-bold text-warm-300">Llámanos</h4>
                                <a href="tel:2454522978" class="text-base font-bold text-white hover:text-chaud-300 transition-colors">
                                    (245) 452 2978
                                </a>
                                <p class="text-[0.72rem] text-warm-400">Atención telefónica en horario de cafetería</p>
                            </div>
                        </div>

                        <!-- WhatsApp -->
                        <div class="flex items-start gap-4">
                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-emerald-500/20 text-emerald-400 backdrop-blur-sm border border-emerald-500/30">
                                <svg class="h-5 w-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                                </svg>
                            </div>
                            <div>
                                <h4 class="text-xs uppercase tracking-wider font-bold text-warm-300">WhatsApp Directo</h4>
                                <a href="https://wa.me/522451099498" target="_blank" rel="noopener noreferrer" class="text-base font-bold text-white hover:text-emerald-300 transition-colors">
                                    +52 (245) 109 9498
                                </a>
                                <p class="text-[0.72rem] text-warm-400">Mensajes para pedidos y reservas</p>
                            </div>
                        </div>

                        <!-- Location -->
                        <div class="flex items-start gap-4">
                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-white/10 text-white backdrop-blur-sm border border-white/10">
                                <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="text-xs uppercase tracking-wider font-bold text-warm-300">Dirección</h4>
                                <p class="text-sm font-semibold text-white leading-relaxed">
                                    Calle 3 Poniente #8, Col. Centro<br />
                                    Ciudad Serdán, Puebla, C.P. 75520
                                </p>
                                <span class="inline-block mt-1 text-[0.72rem] text-honey-400 font-medium">
                                    ★ Justo frente a las letras turísticas de Chalchicomula
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hours & Delivery Note -->
                <div class="rounded-3xl border border-warm-200/90 bg-[#fbf6ee] p-6 shadow-sm">
                    <div class="flex items-center justify-between border-b border-warm-200/70 pb-3 mb-3">
                        <span class="text-xs font-bold uppercase tracking-wider text-warm-700">Horario de servicio</span>
                        <span class="text-xs font-extrabold text-chaud-600">Lunes a Domingo</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-semibold text-espresso-950">11:00 AM – 9:00 PM</span>
                        <span class="text-xs font-medium text-warm-600">Servicio continuo</span>
                    </div>
                    <p class="mt-4 text-xs text-warm-500 leading-relaxed border-t border-warm-200/70 pt-3">
                        🛵 <strong>Servicio a Domicilio:</strong> Disponible en toda Ciudad Serdán por solo $30 pesos de envío.
                    </p>
                </div>

            </div>

            <!-- Google Maps Frame (7 cols) -->
            <div class="lg:col-span-7">
                <div class="overflow-hidden rounded-3xl border border-warm-200/90 bg-white p-3 shadow-xl shadow-warm-900/5 sm:p-4">
                    <iframe
                        src="https://www.google.com/maps?q=Calle+3+poniente+8,+Col+Centro,+Ciudad+Serdán,+Puebla+75520&output=embed&z=18"
                        width="100%"
                        height="450"
                        class="h-[22rem] sm:h-[28rem] w-full rounded-2xl"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="Mapa interactivo con la ubicación de Chaud & Glace en Ciudad Serdán">
                    </iframe>

                    <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-3 px-2 pb-1">
                        <p class="text-xs text-warm-600 text-center sm:text-left">
                            Coordenadas céntricas con estacionamiento cercano y fácil acceso peatonal.
                        </p>
                        <a
                            href="https://www.google.com/maps/search/?api=1&query=Chaud+%26+Glace+Calle+3+poniente+8+Col+Centro+Ciudad+Serdán+Puebla"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-espresso-900 px-4 py-2 text-xs font-bold text-white shadow-sm transition-all hover:bg-chaud-600 hover:-translate-y-0.5"
                        >
                            <span>Abrir en Google Maps</span>
                            <span aria-hidden="true">↗</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- Live Hours Script -->
<script>
    function updateLiveHours() {
        const textEl = document.getElementById('live-hours-text');
        if (!textEl) return;

        const now = new Date();
        const currentHour = now.getHours();

        // 11:00 AM (11) to 9:00 PM (21)
        const isOpen = currentHour >= 11 && currentHour < 21;

        if (isOpen) {
            textEl.innerHTML = `🟢 <strong>Abierto ahora</strong> (Cerramos a las 9:00 PM)`;
        } else {
            textEl.innerHTML = `🟡 <strong>Cerrado por ahora</strong> (Abrimos a las 11:00 AM)`;
        }
    }

    updateLiveHours();
</script>
