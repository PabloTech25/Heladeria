---
import type { Product } from '../data/products';
import { getCloudinaryUrl, getResponsiveSrcSet } from '../lib/cloudinary';
import AddToCartButton from './AddToCartButton.svelte';

interface Props {
  products: Product[];
}

const { products } = Astro.props;

const categories = {
  "Heladería": "Nuestros helados artesanales son la estrella de Chaud & Glace. Elaborados con ingredientes premium, técnicas artesanales y sin conservantes.",
  "Bebidas": "Bebidas frías y calientes pensadas para refrescar y deleitar, desde frappes caseros hasta café gourmet.",
  "Reposteria y Snacks": "Repostería artesanal y snacks frescos preparados diariamente con los mejores ingredientes.",
  "Salados": "Opciones saladas para complementar tu visita, desde sándwiches artesanales hasta opciones ligeras.",
  "Completos": "Nuestras creaciones más elaboradas y especiales, con combinaciones únicas de la casa."
};

type CategoryKey = keyof typeof categories;

const groupedProducts = products.reduce((acc: Record<CategoryKey, Product[]>, product) => {
  const category = product.category as CategoryKey;
  if (!acc[category]) acc[category] = [];
  acc[category].push(product);
  return acc;
}, {} as Record<CategoryKey, Product[]>);
---

<section id="menu" class="border-t border-warm-200 bg-white py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 flex flex-col gap-6 border-b border-warm-200 pb-8 sm:mb-12 sm:pb-10 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="mb-4 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.16em] text-chaud-700"><span class="h-2 w-2 rounded-full bg-chaud-500"></span>La carta de hoy</div>
        <h2 class="store-display max-w-2xl text-4xl font-semibold leading-[0.95] text-warm-900 sm:text-6xl">Algo rico para cada antojo.</h2>
        <p class="mt-5 max-w-xl text-sm leading-relaxed text-warm-600 sm:text-base">Explora la carta, elige tus favoritos y arma tu pedido. Todo se prepara al momento en Ciudad Serdán.</p>
      </div>
      <div class="flex items-center gap-3 text-sm text-warm-600"><span class="flex h-10 w-10 items-center justify-center rounded-full bg-chaud-50 text-chaud-700">★</span><span><strong class="block text-warm-900">4.8 / 5</strong>Favorito de la comunidad</span></div>
    </div>

    <nav aria-label="Categorías del catálogo" class="sticky top-16 z-20 -mx-4 mb-12 overflow-x-auto border-y border-warm-200 bg-white/95 px-4 py-3 backdrop-blur-xl sm:top-20 sm:static sm:mx-0 sm:overflow-visible sm:border-0 sm:bg-transparent sm:p-0">
      <div class="flex min-w-max gap-2 sm:min-w-0 sm:flex-wrap sm:gap-3">
        <a href="#menu" class="rounded-full bg-chaud-600 px-4 py-2 text-sm font-bold text-white shadow-sm">Todo</a>
        {Object.entries(groupedProducts).map(([categoryName], index) => (
          <a href={`#categoria-${index + 1}`} class="rounded-full border border-warm-200 bg-white px-4 py-2 text-sm font-semibold text-warm-700 transition-colors hover:border-chaud-500 hover:text-chaud-700">
            {categoryName === "Reposteria y Snacks" ? "Repostería y snacks" : categoryName}
          </a>
        ))}
      </div>
    </nav>

    {Object.entries(groupedProducts).map(([categoryName, categoryProducts], index) => {
      const description = categories[categoryName as CategoryKey];
      if (!description) return null;

      return (
        <div id={`categoria-${index + 1}`} class="mb-16 scroll-mt-28 sm:mb-20">
          <div class="mb-8">
            <div class="mb-4 flex items-end justify-between gap-4 border-b border-warm-200 pb-4">
              <h3 class="store-display text-3xl font-semibold text-warm-900 sm:text-4xl">{categoryName === "Reposteria y Snacks" ? "Repostería y Snacks" : categoryName}</h3>
              <span class="shrink-0 text-xs font-semibold text-warm-500">{categoryProducts.length} opciones</span>
            </div>
            <p class="max-w-2xl text-sm leading-relaxed text-warm-600 sm:text-base">{description}</p>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {categoryProducts.map((product) => (
              <article class="group overflow-hidden rounded-2xl border border-warm-200 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-chaud-300 hover:shadow-xl hover:shadow-chaud-900/8">
                <div class="relative aspect-[1.15] overflow-hidden bg-chaud-50">
                  <img
                    src={getCloudinaryUrl(product.image, { width: 400 })}
                    srcset={getResponsiveSrcSet(product.image, [320, 400, 640])}
                    sizes="(max-width: 640px) 320px, (max-width: 1024px) 400px, 640px"
                    alt={`${product.name} - ${categoryName} artesanal en Ciudad Serdán, Puebla - Chaud & Glace`}
                    class="h-full w-full object-contain p-5 transition-transform duration-500 group-hover:scale-105 sm:p-7"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute left-3 top-3 rounded-full bg-white px-3 py-1.5 text-sm font-bold text-warm-900 shadow-sm sm:left-4 sm:top-4">{product.price}</div>
                </div>

                <div class="p-5 sm:p-6">
                  <h4 class="mb-2 text-lg font-semibold leading-snug text-warm-900 sm:text-xl">{product.name}</h4>
                  <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-warm-600">{product.description}</p>
                  {product.size && <div class="mb-4 inline-flex border border-chaud-200 bg-chaud-50 px-2.5 py-1.5 text-xs font-semibold text-chaud-600">{product.size}</div>}
                  <div class="mt-5 border-t border-warm-200 pt-4">
                    <AddToCartButton client:idle id={product.id} name={product.name} price={product.numericPrice} image={product.image} size={product.size} />
                  </div>
                </div>
              </article>
            ))}
          </div>

          {categoryProducts.length < 5 && <div class="mt-8 border border-dashed border-chaud-300 bg-chaud-50 p-5 text-center"><p class="text-sm text-warm-600">Tenemos más opciones en esta categoría. Contáctanos para conocer nuestras últimas creaciones.</p></div>}
          <div class="mt-14 border-t border-warm-200 sm:mt-16"></div>
        </div>
      );
    })}
  </div>
</section>
