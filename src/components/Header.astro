---
import CartIcon from './CartIcon.svelte';

interface Props {
    currentPage?: 'home';
}

const { currentPage = 'home' } = Astro.props;
const whatsappHref = 'https://wa.me/522451099498';
const navigationItems = [
    { label: 'Inicio', href: '#inicio' },
    { label: 'Nuestra historia', href: '#sobre-nosotros' },
    { label: 'Menú', href: '#menu' },
    { label: 'Contacto', href: '#contacto' },
];
---

<header
    data-site-header
    class="fixed left-0 right-0 top-0 z-50 border-b border-warm-200/80 bg-white/92 backdrop-blur-xl"
>
    <nav class="relative mx-auto max-w-7xl px-4 py-2.5 sm:px-6 lg:px-8" aria-label="Navegación principal">
        <div class="flex items-center justify-between">
            <a
                href="#inicio"
                class="group flex items-center gap-2.5 rounded-sm transition-opacity duration-200 hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-chaud-500 focus-visible:ring-offset-2 sm:gap-3"
            >
                <img
                    src="/logo/LogoChaud.png"
                    alt="Chaud & Glace Logo"
                    class="h-10 w-10 object-contain sm:h-11 sm:w-11"
                />
                <span class="flex flex-col">
                    <span class="text-base font-bold leading-tight text-warm-900 sm:text-lg">
                        Chaud &amp; Glace
                    </span>
                    <span class="hidden text-[0.65rem] font-bold uppercase tracking-[0.16em] text-chaud-600 sm:block">
                        Cafetería · Heladería
                    </span>
                </span>
            </a>

            <ul
                id="mobile-menu"
                data-mobile-menu
                class="absolute left-4 right-4 top-full mt-0 hidden flex-col gap-1 border-t border-chaud-100 bg-white py-4 md:left-1/2 md:right-auto md:top-1/2 md:flex md:-translate-x-1/2 md:-translate-y-1/2 md:flex-row md:items-center md:gap-6 md:border-0 md:bg-transparent md:p-0"
            >
                {navigationItems.map(({ label, href }) => (
                    <li>
                        <a
                            href={href}
                            aria-current={currentPage === 'home' && href === '#inicio' ? 'page' : undefined}
                            class="block rounded-sm py-2 text-sm font-semibold text-warm-700 transition-colors hover:text-chaud-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-chaud-500 focus-visible:ring-offset-2 md:py-1"
                        >
                            {label}
                        </a>
                    </li>
                ))}
                <li class="md:hidden">
                    <a
                        href={whatsappHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-2 flex min-h-11 items-center justify-center gap-2 rounded-full bg-chaud-600 px-6 py-3 font-semibold text-white shadow-md transition-colors hover:bg-chaud-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-chaud-500 focus-visible:ring-offset-2"
                    >
                        <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a11 11 0 011.21-.502l4.493 1.498a2 2 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                            ></path>
                        </svg>
                        Pedir por WhatsApp
                    </a>
                </li>
            </ul>

            <div class="flex items-center gap-3">
                <CartIcon client:load />

                <a
                    href={whatsappHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hidden min-h-11 items-center gap-2 rounded-full bg-warm-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-chaud-600 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-chaud-500 focus-visible:ring-offset-2 md:flex"
                >
                    <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a11 11 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a11 11 0 011.21-.502l4.493 1.498a2 2 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                        ></path>
                    </svg>
                    Pedir por WhatsApp
                </a>

                <button
                    type="button"
                    data-mobile-menu-toggle
                    class="min-h-11 min-w-11 rounded-sm p-2 text-warm-700 transition-colors hover:text-chaud-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-chaud-500 focus-visible:ring-offset-2 md:hidden"
                    aria-label="Abrir menú"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                >
                    <svg class="h-6 w-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16"
                        ></path>
                    </svg>
                </button>
            </div>
        </div>
    </nav>
</header>

<script>
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const mobileMenuButton = header?.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
    const mobileMenu = header?.querySelector<HTMLElement>('[data-mobile-menu]');

    if (header && mobileMenuButton && mobileMenu) {
        const setMenuState = (isOpen: boolean) => {
            mobileMenu.classList.toggle('hidden', !isOpen);
            mobileMenuButton.setAttribute('aria-expanded', String(isOpen));
            mobileMenuButton.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
        };

        mobileMenuButton.addEventListener('click', () => {
            setMenuState(mobileMenuButton.getAttribute('aria-expanded') !== 'true');
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && mobileMenuButton.getAttribute('aria-expanded') === 'true') {
                setMenuState(false);
                mobileMenuButton.focus();
            }
        });

        document.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const link = target.closest<HTMLAnchorElement>('a[href^="#"]');
            if (link && header.contains(link)) {
                const href = link.getAttribute('href');
                const section = href ? document.getElementById(href.slice(1)) : null;
                if (section) {
                    event.preventDefault();
                    const targetY =
                        section.getBoundingClientRect().top + window.scrollY - header.offsetHeight - 12;
                    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

                    window.scrollTo({
                        top: Math.max(0, targetY),
                        behavior: prefersReducedMotion ? 'auto' : 'smooth',
                    });
                    setMenuState(false);
                }
            }

            if (
                mobileMenuButton.getAttribute('aria-expanded') === 'true' &&
                !header.contains(target)
            ) {
                setMenuState(false);
            }
        });
    }
</script>
